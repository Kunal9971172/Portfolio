# Copy to .env.local and fill in. Never commit .env.local. Keys stay server-side.

# Chat provider: anthropic | openai | gemini  (auto-detected from whichever key is set)
AI_PROVIDER=anthropic
# Optional model override (defaults are set in lib/ai/providers.ts)
# AI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Semantic search embeddings: openai | gemini | none  (default: auto from keys above)
# Anthropic has no embeddings API, so add an OpenAI or Gemini key for semantic search.
# Without one, retrieval falls back to keyword search over the same knowledge base.
EMBEDDING_PROVIDER=auto

# Used for sitemap/robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
